# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional partner destinations for relevant cancellation-flow suggestions.
# Leave blank to use the providers' official sites.
VITE_AFFILIATE_DISNEY_PLUS_URL=""
VITE_AFFILIATE_NOW_TV_URL=""
VITE_AFFILIATE_THE_GYM_GROUP_URL=""
VITE_AFFILIATE_AMAZON_MUSIC_URL=""
VITE_AFFILIATE_UBER_ONE_URL=""

# The production statement scanner runs locally in the browser. Keep the
# legacy remote Gemini route disabled unless it is needed for a controlled
# migration environment and protected with a strong secret (32+ characters).
ENABLE_LEGACY_AI_SCAN_ENDPOINT="false"
LEGACY_AI_SCAN_SHARED_SECRET=""
